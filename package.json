{
  "name": "wannabe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "pnpm build:web",
    "build:web": "next build --webpack",
    "build:functions": "pnpm --dir functions build",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "build:release": "pnpm predeploy:check && pnpm build:web && pnpm build:functions",
    "deploy": "pnpm build:release && firebase deploy --only hosting,functions,firestore:rules,firestore:indexes --project wannabe-game",
    "deploy:dry-run": "pnpm build:release && firebase deploy --only hosting,functions,firestore:rules,firestore:indexes --project wannabe-game --dry-run",
    "start": "pnpm build:web && firebase emulators:start --only hosting --project wannabe-game",
    "emulators:start:e2e": "pnpm build:functions && firebase emulators:start --only auth,firestore,functions",
    "typecheck:web": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:functions": "pnpm --dir functions typecheck",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:functions",
    "lint:web": "eslint",
    "lint:functions": "pnpm --dir functions lint",
    "lint": "pnpm lint:web && pnpm lint:functions",
    "test:web": "node --import tsx --test tests/*.test.mjs tests/*.test.tsx",
    "test:functions": "pnpm --dir functions test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:functions:emulator": "firebase emulators:exec --only firestore \"pnpm --dir functions run test:emulator\"",
    "test:functions:round-actions:emulator": "firebase emulators:exec --only firestore \"pnpm --dir functions run test:round-actions:emulator\"",
    "test:functions:room-lifecycle:emulator": "firebase emulators:exec --only firestore \"pnpm --dir functions run test:room-lifecycle:emulator\"",
    "test": "pnpm test:web && pnpm test:functions",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.spec.mjs\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm run test:rules && pnpm run test:functions:emulator"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@next/env": "16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase": "^12.10.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
